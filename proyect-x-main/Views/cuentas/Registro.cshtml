@model Registro

@{
    ViewData["Title"] = "Crear cuenta";
    Layout = null; // Pantalla limpia y centrada, sin el menú lateral.
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear cuenta - Control de Víveres</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-pagina">
    <div class="login-contenedor">

        <!-- Lado izquierdo: marca -->
        <div class="login-marca">
            <div class="login-emblema"><i class="bi bi-basket2-fill"></i></div>
            <span class="login-eyebrow">Sistema comunitario de víveres</span>
            <h1>VÍVERES</h1>
            <p>Crea tu cuenta y empieza a consultar el inventario, los pedidos y las entregas de la campaña.</p>

            <div class="login-estadistica">
                <strong>100%</strong>
                <span>de acceso de lectura desde el primer minuto</span>
            </div>

            <ul class="login-lista">
                <li>Consulta el inventario en tiempo real</li>
                <li>Revisa el historial de entregas</li>
                <li>Un admin puede darte más permisos después</li>
            </ul>
        </div>

        <!-- Lado derecho: formulario -->
        <div class="login-tarjeta">
            <h2>Crear cuenta</h2>
            <p>Completa tus datos para empezar a usar el sistema</p>

            <form asp-action="Registro" asp-route-urlRetorno="@ViewData["UrlRetorno"]" method="post">
                <div asp-validation-summary="ModelOnly" class="login-error"></div>

                <div class="form-group">
                    <label asp-for="NombreCompleto"></label>
                    <input asp-for="NombreCompleto" class="form-control" placeholder="Tu nombre completo" autofocus />
                    <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Correo"></label>
                    <input asp-for="Correo" class="form-control" placeholder="tucorreo@ejemplo.com" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NombreUsuario"></label>
                    <input asp-for="NombreUsuario" class="form-control" placeholder="Elige un usuario" />
                    <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Contrasena"></label>
                    <input asp-for="Contrasena" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Contrasena" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmarContrasena"></label>
                    <input asp-for="ConfirmarContrasena" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-guardar" style="width: 100%; padding: 0.85rem; font-size: 1rem; background-color: var(--primary);">
                    Crear cuenta
                </button>
            </form>

            <p class="login-credenciales">
                ¿Ya tienes cuenta? <a asp-controller="Cuentas" asp-action="IniciarSesion" asp-route-urlRetorno="@ViewData["UrlRetorno"]">Inicia sesión</a>
            </p>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
