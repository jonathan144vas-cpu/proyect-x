@model IEnumerable<ProductoSeparadoViewModel>

@{
    ViewData["Title"] = "Productos Separados";

    var hoy = DateOnly.FromDateTime(DateTime.Now);

    (string Texto, string Clase) EstadoDe(DateOnly? vencimiento)
    {
        if (vencimiento is not DateOnly fecha)
        {
            return ("Sin fecha", "etiqueta etiqueta-gris");
        }

        var dias = fecha.DayNumber - hoy.DayNumber;

        if (dias < 0) return ("¡VENCIDO!", "etiqueta etiqueta-roja");
        if (dias == 0) return ("Vence hoy", "etiqueta etiqueta-ambar");
        if (dias <= 7) return ($"Vence en {dias} día{(dias == 1 ? "" : "s")}", "etiqueta etiqueta-ambar");
        return ("Buen estado", "etiqueta etiqueta-verde");
    }
}

<div class="container-fluid">
    <div class="header-panel">
        <div>
            <h2><i class="bi bi-boxes"></i> Productos Separados</h2>
            <p style="color: #94a3b8; font-size: 0.85rem; margin-top: 0.25rem;">
                Cada producto del inventario, con todos sus lotes ordenados por fecha de vencimiento
            </p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="tabla-responsive">
            <table class="tabla-viveres">
                <tbody>
                    <tr>
                        <td style="text-align: center; color: #94a3b8; padding: 2rem;">
                            Todavía no hay productos registrados en el inventario.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="grid-productos">
            @foreach (var grupo in Model)
            {
                <div class="tarjeta-producto">
                    <div class="tarjeta-producto-encabezado">
                        <strong>@grupo.Nombre</strong>
                        <a asp-action="Detalle" asp-route-nombre="@grupo.Nombre" class="btn-editar" title="Ver inventario completo de este producto">
                            <i class="bi bi-eye"></i>
                        </a>
                    </div>
                    <ul class="tarjeta-producto-lotes">
                        @foreach (var lote in grupo.Lotes)
                        {
                            var estado = EstadoDe(lote.FechaVencimiento);
                            <li>
                                <span>@lote.Cantidad @lote.UnidadMedida</span>
                                <span class="@estado.Clase">@estado.Texto</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
</div>
