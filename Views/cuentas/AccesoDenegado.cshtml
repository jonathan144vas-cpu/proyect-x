@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container-fluid">
    <div class="form-card" style="max-width: 520px; margin: 3rem auto; text-align: center;">
        <div style="font-size: 2.5rem; color: var(--c-ambar); margin-bottom: 0.75rem;">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-main);">Acceso denegado</h2>

        <p style="color: var(--text-muted); margin-top: 0.75rem;">
            Tu usuario no tiene permiso para entrar a esta pantalla.
            Solo los usuarios con rol <strong>Admin</strong> pueden agregar, editar o eliminar alimentos.
        </p>

        <div class="form-buttons" style="justify-content: center; margin-top: 1.5rem;">
            <a asp-controller="Alimentos" asp-action="Index" class="btn-guardar">Volver al inventario</a>

            <form asp-controller="Cuentas" asp-action="CerrarSesion" method="post" style="display: inline;">
                <button type="submit" class="btn-cancelar">Cerrar sesión</button>
            </form>
        </div>
    </div>
</div>
