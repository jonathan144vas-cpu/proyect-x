@model IEnumerable<Pedido>

@{
    var filaNuevaId = TempData["FilaNuevaId"] as int?;
    ViewData["Title"] = "Pedidos por Realizar";

    var esAdmin = User.IsInRole("Admin");
    var buscarActual = ViewBag.Buscar as string;
    var estadoActual = ViewBag.Estado as EstadoPedido?;

    var pendientes = Model.Count(p => p.Estado == EstadoPedido.Pendiente);
    var solicitados = Model.Count(p => p.Estado == EstadoPedido.Solicitado);
    var recibidos = Model.Count(p => p.Estado == EstadoPedido.Recibido);

    // Columnas: Artículo, Categoría, Cantidad, Prioridad, Se necesita, Estado, Fecha emitida (+ Acciones)
    var totalColumnas = esAdmin ? 8 : 7;

    string ClaseEstado(EstadoPedido estado) => estado switch
    {
        EstadoPedido.Pendiente => "etiqueta etiqueta-ambar",
        EstadoPedido.Solicitado => "etiqueta etiqueta-azul",
        EstadoPedido.Recibido => "etiqueta etiqueta-verde",
        _ => "etiqueta etiqueta-gris"
    };

    string ClasePrioridad(PrioridadPedido prioridad) => prioridad switch
    {
        PrioridadPedido.Alta => "etiqueta etiqueta-roja",
        PrioridadPedido.Normal => "etiqueta etiqueta-azul",
        _ => "etiqueta etiqueta-gris"
    };
}

<div class="container-fluid">
    <div class="header-panel">
        <div>
            <h2><i class="bi bi-cart-plus"></i> Pedidos por Realizar <small class="sub-parentesis">(Empresas y proveedores)</small></h2>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.25rem;">
                Lista de víveres que hacen falta comprar
            </p>
        </div>

        @if (esAdmin)
        {
            <a asp-action="Crear" class="btn-nuevo">+ Nuevo Pedido</a>
        }
    </div>

    <div class="tarjetas-resumen">
        <div class="tarjeta">
            <div class="tarjeta-etiqueta">Pendientes</div>
            <div class="tarjeta-valor" style="color: var(--c-ambar);">@pendientes</div>
        </div>
        <div class="tarjeta">
            <div class="tarjeta-etiqueta">Solicitados</div>
            <div class="tarjeta-valor" style="color: var(--c-azul);">@solicitados</div>
        </div>
        <div class="tarjeta">
            <div class="tarjeta-etiqueta">Recibidos</div>
            <div class="tarjeta-valor" style="color: var(--c-verde);">@recibidos</div>
        </div>
    </div>

    <form method="get" class="filtros">
        <input type="text" name="buscar" placeholder="Buscar artículo..." value="@buscarActual" />
        @* Se arma con SelectList para que el filtro elegido siga marcado al recargar. *@
        <select name="estado" asp-items="@(new SelectList(Html.GetEnumSelectList<EstadoPedido>(), "Value", "Text", ((int?)estadoActual)?.ToString()))">
            <option value="">Todos los estados</option>
        </select>
        <button type="submit">Filtrar</button>
    </form>

    <div class="tabla-responsive">
        <table class="tabla-viveres">
            <thead>
                <tr>
                    <th>Artículo</th>
                    <th>Categoría</th>
                    <th>Cantidad</th>
                    <th>Prioridad</th>
                    <th>Se necesita</th>
                    <th>Estado</th>
                    <th>Fecha emitida</th>
                    @if (esAdmin)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="@totalColumnas" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                            No hay pedidos que coincidan con la búsqueda.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.Id == filaNuevaId ? "fila-nueva" : "")">
                            <td data-label="Artículo">
                                <strong>@item.Articulo</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Proveedor))
                                {
                                    <div style="color: var(--text-subtle); font-size: 0.8rem;">@item.Proveedor</div>
                                }
                            </td>
                            <td data-label="Categoría">@item.Categoria</td>
                            <td data-label="Cantidad">@item.Cantidad @item.UnidadMedida</td>
                            <td data-label="Prioridad">
                                <span class="@ClasePrioridad(item.Prioridad)">@item.Prioridad</span>
                            </td>
                            <td data-label="Se necesita">
                                @(item.FechaNecesaria?.ToString("dd/MM/yyyy") ?? "Sin fecha")
                            </td>
                            <td data-label="Estado">
                                <span class="@ClaseEstado(item.Estado)">@item.Estado</span>
                            </td>
                            <td data-label="Fecha emitida">@item.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                            @if (esAdmin)
                            {
                                <td data-label="Acciones" class="acciones">
                                    @if (item.Estado != EstadoPedido.Recibido && item.Estado != EstadoPedido.Cancelado)
                                    {
                                        <form asp-action="Recibir" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="button" class="btn-recibir js-recibir"
                                                    data-articulo="@item.Articulo"
                                                    data-cantidad="@item.Cantidad @item.UnidadMedida"
                                                    data-vencimiento="@item.FechaVencimiento?.ToString("yyyy-MM-dd")">
                                                Recibir
                                            </button>
                                        </form>
                                    }

                                    @if (item.Estado == EstadoPedido.Recibido)
                                    {
                                        <a asp-action="ComprobanteRecepcion" asp-route-id="@item.Id" class="btn-editar" target="_blank">
                                            Comprobante
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn-editar">Editar</a>
                                    }

                                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        <button type="button" class="btn-eliminar js-eliminar" data-nombre="@item.Articulo">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        @{
            var idComprobante = TempData["ComprobanteRecepcionId"] as int?;
        }
        @if (idComprobante is not null)
        {
            <text>
            window.open('@Url.Action("ComprobanteRecepcion", new { id = idComprobante })', '_blank');
            </text>
        }

        function confirmar(boton, opciones) {
            var formulario = boton.closest('form');

            Swal.fire(Object.assign({
                background: '#1e293b',
                color: '#f8fafc',
                showCancelButton: true,
                cancelButtonColor: '#475569',
                cancelButtonText: 'Cancelar'
            }, opciones)).then(function (resultado) {
                if (resultado.isConfirmed) {
                    formulario.submit();
                }
            });
        }

        document.querySelectorAll('.js-eliminar').forEach(function (boton) {
            boton.addEventListener('click', function () {
                confirmar(boton, {
                    title: '¿Eliminar pedido?',
                    text: 'Estás a punto de eliminar el pedido de "' + boton.dataset.nombre + '".',
                    icon: 'warning',
                    confirmButtonColor: '#ef4444',
                    confirmButtonText: 'Sí, eliminar'
                });
            });
        });

        document.querySelectorAll('.js-recibir').forEach(function (boton) {
            boton.addEventListener('click', function () {
                var formulario = boton.closest('form');
                var vencimiento = boton.dataset.vencimiento;
                var detalle = 'Se sumarán ' + boton.dataset.cantidad + ' de "' + boton.dataset.articulo + '" al inventario.';

                // El pedido ya trae su fecha de vencimiento: pasa igual al inventario.
                if (vencimiento) {
                    var partes = vencimiento.split('-');
                    confirmar(boton, {
                        title: '¿Marcar como recibido?',
                        text: detalle + ' Vence el ' + partes[2] + '/' + partes[1] + '/' + partes[0] + '.',
                        icon: 'question',
                        confirmButtonColor: '#10b981',
                        confirmButtonText: 'Sí, recibir'
                    });
                    return;
                }

                // Sin fecha en el pedido: se pide aquí para que el producto no entre "sin fecha".
                Swal.fire({
                    title: '¿Marcar como recibido?',
                    html: '<p style="margin-bottom:0.9rem">' + detalle + '</p>' +
                          '<label for="fechaVenc" style="display:block;text-align:left;font-size:0.85rem;margin-bottom:0.3rem">Fecha de vencimiento</label>' +
                          '<input id="fechaVenc" type="date" class="swal2-input" style="margin:0;width:100%">' +
                          '<label style="display:flex;gap:0.5rem;align-items:center;margin-top:0.9rem;font-size:0.85rem">' +
                          '<input id="sinVenc" type="checkbox"> Este producto no tiene fecha de vencimiento</label>',
                    focusConfirm: false,
                    showCancelButton: true,
                    cancelButtonColor: '#475569',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#10b981',
                    confirmButtonText: 'Sí, recibir',
                    preConfirm: function () {
                        var fecha = document.getElementById('fechaVenc').value;
                        var sin = document.getElementById('sinVenc').checked;
                        if (!fecha && !sin) {
                            Swal.showValidationMessage('Escribe la fecha de vencimiento o marca que no tiene.');
                            return false;
                        }
                        return sin ? '' : fecha;
                    }
                }).then(function (resultado) {
                    if (!resultado.isConfirmed) return;
                    if (resultado.value) {
                        var campo = document.createElement('input');
                        campo.type = 'hidden';
                        campo.name = 'fechaVencimiento';
                        campo.value = resultado.value;
                        formulario.appendChild(campo);
                    }
                    formulario.submit();
                });
            });
        });
    </script>
}
