@model Proveedor

@* Cuadro "Agregar proveedor". Va fuera del formulario del pedido (no se pueden anidar
   formularios) y se envía con fetch desde proveedores-pedido.js. *@

<dialog id="dialogoProveedor" class="dialogo-proveedor" aria-labelledby="tituloDialogoProveedor">
    <form asp-controller="Proveedores" asp-action="Crear" method="post" id="formularioProveedor" novalidate>
        <h3 id="tituloDialogoProveedor">Agregar proveedor</h3>

        <div class="form-group">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej: Granos del Altiplano" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Categoria"></label>
            <select asp-for="Categoria" id="proveedorCategoria" class="form-control" asp-items="@(new SelectList(Catalogos.Categorias))">
                <option value="">Seleccione el área</option>
            </select>
            <span asp-validation-for="Categoria" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Telefono"></label>
            <input asp-for="Telefono" type="tel" class="form-control" placeholder="Ej: 2234-5678" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Direccion"></label>
            <input asp-for="Direccion" class="form-control" placeholder="Zona, ciudad o municipio" />
            <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="AsesorEncargado"></label>
            <input asp-for="AsesorEncargado" class="form-control" placeholder="Persona que nos atiende" />
            <span asp-validation-for="AsesorEncargado" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Correo"></label>
            <input asp-for="Correo" type="email" class="form-control" placeholder="Opcional" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Observaciones"></label>
            <textarea asp-for="Observaciones" class="form-control" placeholder="Opcional"></textarea>
            <span asp-validation-for="Observaciones" class="text-danger"></span>
        </div>

        <p class="text-danger" id="errorProveedor" hidden></p>

        <div class="form-buttons">
            <button type="submit" class="btn-guardar">Guardar proveedor</button>
            <button type="button" class="btn-cancelar" id="cancelarProveedor">Cancelar</button>
        </div>
    </form>
</dialog>
