@{
    ViewData["Title"] = "Inicio";
}

<div class="panel-hero">
    <h1>Hola, @User.Identity!.Name 👋</h1>
    <p>
        Ayudemos a nuestro país a salir de la desnutrición. Desde aquí puedes llevar el
        inventario de víveres, programar entregas y avisar cuáles alimentos están por vencer.
    </p>
</div>

<div class="accesos-grid">
    <a asp-controller="Alimentos" asp-action="Index" class="acceso-card">
        <span class="acceso-icono acceso-icono-verde"><i class="bi bi-basket"></i></span>
        <h3>Inventario</h3>
        <p>Consulta y administra los víveres disponibles en bodega, por lote y fecha de vencimiento.</p>
    </a>

    <a asp-controller="Alimentos" asp-action="ProductosSeparados" class="acceso-card">
        <span class="acceso-icono acceso-icono-celeste"><i class="bi bi-boxes"></i></span>
        <h3>Productos Separados</h3>
        <p>Mira cada producto por separado, con todos sus lotes ordenados por fecha de vencimiento.</p>
    </a>

    <a asp-controller="Pedidos" asp-action="Index" class="acceso-card">
        <span class="acceso-icono acceso-icono-ambar"><i class="bi bi-cart-plus-fill"></i></span>
        <h3>Pedidos por realizar</h3>
        <p>Solicita víveres que hacen falta y registra su recepción con comprobante en PDF.</p>
    </a>

    <a asp-controller="VisitasPrevias" asp-action="Index" class="acceso-card">
        <span class="acceso-icono acceso-icono-morado"><i class="bi bi-clipboard-check"></i></span>
        <h3>Revisión Previa</h3>
        <p>Propón visitas a comunidades y apruébalas para programarlas como entregas.</p>
    </a>

    <a asp-controller="EntregasProgramadas" asp-action="Index" class="acceso-card">
        <span class="acceso-icono acceso-icono-azul"><i class="bi bi-truck"></i></span>
        <h3>Entregas Programadas</h3>
        <p>Programa entregas hacia comunidades por visitar y genera su comprobante al completarlas.</p>
    </a>

    <a asp-controller="Entregas" asp-action="Index" class="acceso-card">
        <span class="acceso-icono acceso-icono-rojo"><i class="bi bi-gift-fill"></i></span>
        <h3>Donaciones Entregadas</h3>
        <p>Consulta el historial de comunidades donde ya se entregaron víveres, con su comprobante en PDF.</p>
    </a>

    <a asp-controller="Visualizacion" asp-action="Index" class="acceso-card">
        <span class="acceso-icono acceso-icono-verde"><i class="bi bi-bar-chart-line-fill"></i></span>
        <h3>Visualización</h3>
        <p>Gráficas de lo que hay en bodega, los pedidos y los envíos que faltan por hacer.</p>
    </a>

    <a asp-controller="Pobreza" asp-action="Index" class="acceso-card">
        <span class="acceso-icono acceso-icono-ambar"><i class="bi bi-geo-alt-fill"></i></span>
        <h3>Pobreza en Guatemala</h3>
        <p>Mapa de la pobreza por departamento y hacia dónde está llegando la campaña.</p>
    </a>
</div>
